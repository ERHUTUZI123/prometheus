{
  "schema_version": "2.0",
  "kind": "workflow_specification_not_vendor_config",
  "goal": "Potential paradigm-level value in computational organization or learning",
  "research_modes": {
    "discovery": "problem formation and protected mechanism invention",
    "validation": "freeze a concrete claim and discriminating checks"
  },
  "model_policy": {
    "requested_mode": "pro",
    "model_identifier": "read_from_actual_host",
    "effort": "highest_supported_setting_selected_for_this_run",
    "silent_fallback": false,
    "separate_requested_observed_effective": true,
    "unknown_effective_remains_unknown": true,
    "alternative_requires_current_run_authorization": true,
    "previous_campaign_authorization_inherited": false
  },
  "orchestration": {
    "initial_entries": [
      "P",
      "K",
      "R"
    ],
    "primary_candidates_target": 1,
    "high_risk_alternatives_target": 1,
    "candidate_count_is_quota": false,
    "native_independent_contexts_preferred": true,
    "freeze_before_exchange": true,
    "old_reports_release": "after_first_substantive_freeze",
    "entry_R_receives_curated_index_initially": false,
    "mode_receipt_per_substantive_worker": true,
    "concurrency": "host_supported_and_resource_appropriate"
  },
  "knowledge": {
    "library": "optional_primary_source_resource",
    "source_quota": null,
    "outside_search": "authorized_and_encouraged_when_relevant",
    "primary_reading_required_for_load_bearing_claims": true
  },
  "selection": {
    "success_counterfactual_before_major_implementation": true,
    "easy_verification_is_not_priority": true,
    "new_low_level_primitives_required": false,
    "no_neural_networks_requirement": false,
    "strongest_matched_rival_early": true,
    "focus_after_discovery": true
  },
  "budget": {
    "artificial_campaign_token_cap": null,
    "artificial_round_cap": null,
    "use": "authorized_available_resources_for_informative_work",
    "maximize_token_consumption": false,
    "reserve_checkpoint_and_delivery": true,
    "every_executable_probe_requires_external_limits": true,
    "new_paid_resources": "separate_authorization"
  },
  "persistence": {
    "run_root": ".deep-work/<new-run-id>",
    "human_state": "existing_canonical_NOW_only",
    "old_campaigns": "read_only",
    "raw_records": "incremental",
    "summary_write": "atomic_or_recoverable",
    "model_weights": "checkpoint_before_summary",
    "missing_logs": "never_fabricated"
  },
  "phases": [
    "preflight",
    "independent_discovery",
    "freeze",
    "success_counterfactual_and_rival",
    "focus",
    "construct_attack_repair",
    "discriminating_validation",
    "mechanism_revision_or_reselect",
    "independent_rebuild",
    "final"
  ],
  "tools": {
    "policy": "all_currently_authorized_research_tools",
    "raw_sources": "read_only",
    "generated_code": "isolated_no_credentials",
    "external_publication": false,
    "self_provisioning": false
  },
  "stop": {
    "conditions": [
      "scientifically_meaningful_delivery",
      "distinct_explorations_no_new_mechanism_information",
      "genuine_permission_mode_or_resource_boundary",
      "user_stop"
    ],
    "difficulty_alone": false,
    "unresolved_field_alone": false,
    "resume_from_checked_artifacts": true
  }
}
