for leaf,raw in c['files'].items():
 b=base64.b64decode(raw)
 if hashlib.sha256(b).hexdigest()!=c['source_sha256'][leaf]:raise ValueError('source transport mismatch')
 p=code/leaf;p.write_bytes(b);p.chmod(0o444)
