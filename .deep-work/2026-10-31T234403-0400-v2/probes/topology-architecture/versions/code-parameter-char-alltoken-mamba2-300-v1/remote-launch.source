 for name in('tmp','torch','cache','cuda-cache','triton-cache','pycache'):
  root=out/name;files=total=0
  for folder,directories,leaves in os.walk(root,followlinks=False):
   directories[:]=[n for n in directories if not(pathlib.Path(folder)/n).is_symlink()]
   for leaf in leaves:
    path=pathlib.Path(folder)/leaf
    if not path.is_symlink():files+=1;total+=path.stat().st_size
    if files>20000:raise RuntimeError('bounded cache metadata walk exceeded')
  result[name]=dict(files=files,bytes=total)
 return result
