import ast, base64, hashlib, json, os, pathlib, resource, shutil, subprocess, sys, time
c = CONFIG
r = pathlib.Path('/workspace/prometheus-v2-m0-architecture')
name = c['name']
code = r / ('code-' + name)
out = r / 'outputs' / name
inputs = pathlib.Path('/opt/prometheus-' + name + '-inputs')
receipt = out.parent / (name + '.coordinator-exit.json')
status = out.parent / (name + '.runner-status.json')
input_receipt = out.parent / (name + '.input-manifest.json')

def sha(p):
    return hashlib.sha256(p.read_bytes()).hexdigest()

def load(p):
    return json.loads(p.read_text()) if p.is_file() else None

def regular(p, expected):
    if p.is_symlink() or not p.is_file() or p.stat().st_size > 100 * 1024 * 1024 or (sha(p) != expected):
        raise ValueError('fixed bounded OWN artifact changed: ' + str(p))
if os.geteuid() != 0:
    raise PermissionError('trusted ROOT coordinator required')
if any((p.exists() or p.is_symlink() for p in (code, out, inputs, receipt, status, input_receipt))):
    raise FileExistsError('newnamespaceonly; preserveeveryattempt')
