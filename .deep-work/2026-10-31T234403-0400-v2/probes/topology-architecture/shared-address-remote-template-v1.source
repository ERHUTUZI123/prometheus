            continue
        if v.get('event') == 'sandbox_ready':
            sandbox.append(v)
checks = dict(runner_exit0=returncode == 0, root_completed=bool(root and root.get('status') == 'completed'), strict_before_science=any((v.get('seccomp') == 'enforced_tsync' and v.get('uid') == 65534 for v in sandbox)), actualfresh2400=bool(result and result.get('actual_new_updates_this_process') == 2400 and result.get('fresh_initial_NN') and (result.get('parent_NN_loaded') is False) and (result.get('historical_updates_shared') == 0)), fixedarchitecture=bool(result and result.get('architecture_policy') == c['architecture_policy']), exact_sources=bool(result and result.get('source_sha256') == c['source_sha256']), exact_P=bool(result and result['resources']['parameters'] == 10805), two_captures=bool(result and result.get('actual_graph_capture_count') == 2 and ([g['bucket'] for g in result['graphs']] == [16, 48]) and ([g['training_FB_calls'] for g in result['graphs']] == [1800, 600])), all23_stable=bool(result and result.get('all23_grad_storage_stable_within_capture')), four_safety_reload=bool(result and len(result['reports']) == 4 and all((r.get('premaintenance_safety_checkpoint') and r.get('reload', {}).get('exact_NN_Adam_RNG_replay_forward') for r in result['reports']))), frozen_TEST=bool(result and result.get('NN_unchanged_after_TEST') and freeze and (freeze.get('TEST_read') is False) and (freeze.get('actual_new_updates') == 2400)), no_score_gate=bool(result and result.get('accuracy_or_speed_gate') is False))
passed = all(checks.values())
after = resource.getrusage(resource.RUSAGE_CHILDREN)
value = dict(name=name, architecture_policy=c['architecture_policy'], returncode=returncode, protocol_completed=passed, checks=checks, error=error, source_sha256=c['source_sha256'], runner_sha256=c['runner_sha256'], CPU_proof_sha256=sha(proof_path), input_manifest_sha256=sha(input_receipt), coordinator_wall_seconds=time.monotonic() - started, coordinator_CPU_seconds=time.process_time() - cpu, reaped_child_CPU_seconds=after.ru_utime + after.ru_stime - (before.ru_utime + before.ru_stime), command=command, summary_path=str(out / 'learn/result.json'), root_status_path=str(status), no_compiler_exception=True, formal_Primary=False, no_accuracy_or_speed_gate=True, full_training_FLOPs=None, provider_effective_compute=None, cost_scope='eachprospectivearm ownfresh2400 paidseparately/2captures/6warmups/all23reference+graphdiagnostics/copies/padding/cache+probmemory/sharedaddress/static-episodekeys/eagerclip+Adam/VALID/TEST/inference/safety+checkpoint/reload/maintenance/source/data/raw/wholeCPUwall; nestedtimesshouldnotbesummed')
if result:
    value.update(initial_theta_sha256=result['initial_theta_sha256'], P=result['resources']['parameters'], checkpoint=result['checkpoint'], stage_update_wall_seconds=[r['costs']['training_wall_seconds'] for r in result['reports']], total_update_wall_seconds=sum((r['costs']['training_wall_seconds'] for r in result['reports'])), total_padded_forward_MAC=sum((r['costs']['padded_forward_MAC_proxy'] for r in result['reports'])), driver_wall_seconds=result['driver_wall_seconds'], driver_CPU_seconds=result['driver_CPU_seconds'])
with receipt.open('x') as f:
    json.dump(value, f, indent=2, sort_keys=True)
    f.write('\n')
print(json.dumps(value, sort_keys=True), flush=True)
raise SystemExit(0 if passed else returncode if returncode not in (None, 0) else 1)
