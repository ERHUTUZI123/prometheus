        raise ValueError('CPU/GPUcommon source identity differs: ' + leaf)
runner = r / 'remote_runner_gpu_authorized.py'
regular(runner, c['runner_sha256'])
code.mkdir()
inputs.mkdir()
for leaf, encoded in c['files'].items():
    raw = base64.b64decode(encoded, validate=True)
    if hashlib.sha256(raw).hexdigest() != c['source_sha256'][leaf]:
        raise ValueError('source transport changed')
    ast.parse(raw)
    with (code / leaf).open('xb') as f:
        f.write(raw)
    (code / leaf).chmod(292)
code.chmod(365)
actual = {}
for key, spec in c['manifest']['files'].items():
    src = r / 'outputs' / spec['remote_relative']
    regular(src, spec['sha256'])
    dst = inputs / spec['leaf']
    shutil.copyfile(src, dst)
    regular(dst, spec['sha256'])
    dst.chmod(292)
    actual[key] = dict(spec, bytes=dst.stat().st_size)
with (inputs / 'manifest.json').open('x') as f:
    json.dump(c['manifest'], f, indent=2, sort_keys=True)
    f.write('\n')
(inputs / 'manifest.json').chmod(292)
inputs.chmod(365)
with input_receipt.open('x') as f:
    json.dump(dict(source_sha256=c['source_sha256'], common_source_sha256=c['common_source_sha256'], files=actual, manifest_sha256=sha(inputs / 'manifest.json'), CPU_proof_sha256=sha(proof_path), readonly_input_disk_bytes=sum((v['bytes'] for v in actual.values()))), f, indent=2, sort_keys=True)
    f.write('\n')
input_receipt.chmod(292)
command = [sys.executable, str(runner), '--script', str(code / 'train_shared_address_fourstage_graph.py'), '--out', str(out), '--timeout', '900', '--address-space-gib', '512', '--file-limit-mib', '100', '--gpu-fraction', '.3', '--cuda-init-before-seccomp', '--', '--inputs', str(inputs), '--out', str(out / 'learn'), '--max-seconds', '850']
started = time.monotonic()
cpu = time.process_time()
before = resource.getrusage(resource.RUSAGE_CHILDREN)
try:
    x = subprocess.run(command, capture_output=True, text=True, timeout=930)
    returncode = x.returncode
    stdout = x.stdout
    stderr = x.stderr
    error = None
except subprocess.TimeoutExpired as e:

    def string(v):
        return v.decode(errors='replace') if isinstance(v, bytes) else v or ''
    returncode = None
    stdout = string(e.stdout)
    stderr = string(e.stderr)
    error = 'coordinatorwaittimeout, inspectactualboundedrunner; noautorerun'
for leaf, value in ((name + '.coordinator-stdout.log', stdout), (name + '.coordinator-stderr.log', stderr)):
    with (out.parent / leaf).open('x') as f:
        f.write(value)
root = load(status)
result = load(out / 'learn/result.json')
freeze = load(out / 'learn/ALL_TRAINING_FROZEN_BEFORE_TEST.json')
sandbox = []
if (out / 'stdout.log').is_file():
    for line in (out / 'stdout.log').read_text().splitlines():
        try:
