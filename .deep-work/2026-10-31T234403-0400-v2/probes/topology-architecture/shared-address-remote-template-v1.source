proof = load(proof_path)
proof_root = load(r / 'outputs' / (c['CPU_gate_run'] + '.runner-status.json'))
if not proof or not proof_root or proof_root.get('status') != 'completed' or (proof.get('status') != 'CPU_INPUT_HISTORY_SHARED_ADDRESS_GRAPH_ADMISSION_PASS') or (proof.get('P15') != 10789) or (proof.get('P16') != 10805) or (proof.get('logical_carry_scalars') != 248) or (proof.get('SGD_updates') != 0) or (proof.get('research_updates') != 0):
    raise ValueError('actualpairedCPUadmissionrequired')
for key in ('only23_retained_NN_parameters', 'retained_initialization_exact_subset', 'cache_output_api_checks', 'all23_gradients_checked', 'old_policy_and_wrong_configuration_rejected', 'controller_independent_of_h', 'episode_keys_fixed_trainable', 'shared_read_write_attention'):
    if proof.get(key) is not True:
