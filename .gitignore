# ============================================================
# Prometheus — .gitignore
# ============================================================

# Python environments
.venv/
venv/
env/
.conda/
.direnv/

# Python caches and build outputs
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/
.ipynb_checkpoints/

# Secrets and local credentials
.env
.env.*
!.env.example
secrets/
credentials/
.aws/
.ssh/
*.pem
*.key
*.p12
*.pfx
*.p8
*credentials*.json

# Raw/local data and model artifacts
# Root-level only: preserve nested research evidence
/data/
/datasets/
/checkpoints/
/models/

# Large model artifacts
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
*.h5
*.hdf5

# Transient experiment outputs
# Root-level only
/runs/*
!/runs/.gitkeep
/outputs/
wandb/
mlruns/
lightning_logs/
events.out.tfevents.*

# Logs
*.log

# Preserve scientific execution logs
!/.deep-work/**/*.log

# Local editor artifacts
.idea/
.vscode/
*.swp
*.swo
*~
*.tmp

# macOS artifacts
.DS_Store
._*
.AppleDouble/
.Spotlight-V100/
.Trashes/
.fseventsd/

# Windows artifacts
Thumbs.db

# JavaScript / Swift build outputs
node_modules/
.next/
.build/
DerivedData/

# Project-specific exclusions
oracle.cmd
water/push.txt

# ============================================================
# Scientific research records
# ============================================================

# Intentionally DO NOT ignore .deep-work/
# Preserve research hypotheses, derivations, experiments,
# raw evidence, independent reviews, and checkpoints.
#
# Review files for secrets and private data before committing.
# Large binary checkpoints are still excluded by extension.
# ============================================================